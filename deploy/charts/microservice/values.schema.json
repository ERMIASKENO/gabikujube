{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "microservice chart values",
  "type": "object",
  "required": ["image", "rollout"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" }
      }
    },
    "rollout": {
      "type": "object",
      "properties": {
        "strategy": { "enum": ["canary", "blueGreen", "rolling"] }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "paths": { "type": "array", "items": { "type": "string", "pattern": "^/" } }
      }
    }
  }
}
